{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "RPS per Endpoint",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(social_network_http_requests_total[2m])) by (method, endpoint, status)",
          "legendFormat": "{{method}} {{endpoint}} ({{status}})"
        }
      ]
    },
    {
      "title": "Postgres Pool Connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "db_pool_active_conns",
          "legendFormat": "Active"
        },
        {
          "expr": "db_pool_idle_conns",
          "legendFormat": "Idle"
        },
        {
          "expr": "db_pool_total_conns",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "title": "Redis Pool Connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "redis_pool_total_conns",
          "legendFormat": "Total"
        },
        {
          "expr": "redis_pool_idle_conns",
          "legendFormat": "Idle"
        }
      ]
    },
    {
      "title": "Cache Hit Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[2m])) by (cache_name) / (sum(rate(cache_hits_total[2m])) by (cache_name) + sum(rate(cache_misses_total[2m])) by (cache_name))",
          "legendFormat": "{{cache_name}}"
        }
      ]
    },
    {
      "title": "DB Acquisition Wait",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(db_pool_acquire_wait_duration_seconds_total[1m])",
          "legendFormat": "Wait Duration"
        }
      ]
    },
    {
      "title": "Latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(social_network_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "title": "Worker Processed Events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(social_network_worker_processed_events_total[2m])) by (event_type, status)",
          "legendFormat": "{{event_type}} ({{status}})"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Social Network Application Metrics",
  "uid": "social_network_metrics",
  "version": 1
}
